# ==========================================
# LA MAIA — Root Environment Variables
# ==========================================

# Core Runtime
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lamaia_dev?schema=public"

# Cache & Queues (Redis 7)
REDIS_URL="redis://localhost:6379"

# API Service
API_PORT=4000
API_PREFIX="v1"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
JWT_SECRET="lamaia_development_secret_key_minimum_32_characters_length!"

# Worker Service
WORKER_PORT=4001

# Storefront Web (Next.js)
NEXT_PUBLIC_STOREFRONT_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000/v1"

# Admin Web (Next.js)
NEXT_PUBLIC_ADMIN_PORT=3001

# Cloudinary (Phase 02)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (Phase 07)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket (Phase 09)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

